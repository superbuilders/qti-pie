{
  "name": "qti-pie",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#tools/*": "./tools/*"
  },
  "scripts": {
    "typecheck": "toolchain-typecheck",
    "fixtures:oxlint": "node tools/classes-live-in-styles.fixtures.ts",
    "oxlint": "oxlint --type-aware",
    "test:specimen-db": "mkdir -p work/.vp-tmp && TMPDIR=\"$PWD/work/.vp-tmp\" NODE_OPTIONS=\"$NODE_OPTIONS --disable-proto=delete --disable-sigusr1\" vitest run --config suites/vitest.config.ts"
  },
  "devDependencies": {
    "@bjornpagen/devtools": "workspace:*",
    "@bjornpagen/testing": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@qti-pie/crust": "workspace:*",
    "@qti-pie/pantry": "workspace:*",
    "@qti-pie/plate": "workspace:*",
    "@qti-pie/specimen": "workspace:*",
    "@stylistic/eslint-plugin": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vitest": "catalog:"
  }
}
