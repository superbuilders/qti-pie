{
  "name": "@qti-pie/specimen",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#specimen/*": "./src/*"
  },
  "exports": {
    "./floor": "./src/floor.ts",
    "./open": "./src/open.ts",
    "./specimen": "./src/specimen.ts"
  },
  "scripts": {
    "typecheck": "sh -c 'toolchain-typecheck -p src/ui/tsconfig.json \"$@\" & ui=$!; toolchain-typecheck -p src/alpha/tsconfig.json \"$@\" & alpha=$!; toolchain-typecheck -p tsconfig.json \"$@\"; specimen=$?; wait $ui || exit 1; wait $alpha || exit 1; exit $specimen' typecheck",
    "test": "mkdir -p work/.vp-tmp && TMPDIR=\"$PWD/work/.vp-tmp\" node --disable-proto=delete --disable-sigusr1 --throw-deprecation --pending-deprecation --force-context-aware --no-global-search-paths --unhandled-rejections=strict \"$(node -p \"path.join(path.dirname(require.resolve('vitest/package.json')), 'vitest.mjs')\")\" run"
  },
  "dependencies": {
    "@bjornpagen/testing": "workspace:*",
    "@qti-pie/crust": "workspace:*",
    "@qti-pie/plate": "workspace:*",
    "arkregex": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@bjornpagen/devtools": "workspace:*",
    "@effect/vitest": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "linkedom": "catalog:",
    "mathlive": "catalog:",
    "playwright-core": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vitest": "catalog:"
  }
}
