{
  "name": "@qti-pie/pantry",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#pantry/*": "./src/*",
    "#migrations/*": "./migrations/*"
  },
  "exports": {
    "./db/connection.ts": "./src/db/connection.ts",
    "./db/layer.ts": "./src/db/layer.ts",
    "./db/served.ts": "./src/db/served.ts",
    "./export/pages.ts": "./src/export/pages.ts",
    "./export/render.ts": "./src/export/render.ts",
    "./export/scan.ts": "./src/export/scan.ts",
    "./grammar/domains.ts": "./src/grammar/domains.ts",
    "./grammar/install.ts": "./src/grammar/install.ts",
    "./import/package.ts": "./src/import/package.ts",
    "./import/program.ts": "./src/import/program.ts",
    "./import/read.ts": "./src/import/read.ts",
    "./import/refusal.ts": "./src/import/refusal.ts",
    "./package/media.ts": "./src/package/media.ts",
    "./qti/limits.ts": "./src/qti/limits.ts",
    "./qti/logins.ts": "./src/qti/logins.ts",
    "./qti/lom.ts": "./src/qti/lom.ts",
    "./qti/media.ts": "./src/qti/media.ts",
    "./qti/positions.ts": "./src/qti/positions.ts",
    "./qti/roles.ts": "./src/qti/roles.ts",
    "./qti/schema.ts": "./src/qti/schema.ts",
    "./qti/templates.ts": "./src/qti/templates.ts",
    "./test/admission.ts": "./src/test/admission.ts",
    "./test/file-database.ts": "./src/test/file-database.ts",
    "./vocab/laws.ts": "./src/vocab/laws.ts"
  },
  "scripts": {
    "typecheck": "toolchain-typecheck",
    "db": "scripts/db.sh",
    "fetch-xsds": "node src/vocab/derive/fetch-xsds.ts",
    "fetch-specs": "node src/test/spec-cache/fetch.ts",
    "grizzle": "grizzle",
    "grizzle:check": "grizzle check grizzle.config.ts",
    "test": "mkdir -p work/.vp-tmp && TMPDIR=\"$PWD/work/.vp-tmp\" NODE_OPTIONS=\"$NODE_OPTIONS --disable-proto=delete --disable-sigusr1\" vitest run",
    "plan-budget": "plan-budget"
  },
  "dependencies": {
    "@bjornpagen/grizzle": "workspace:*",
    "@bjornpagen/grizzle-text": "workspace:*",
    "@bjornpagen/testing": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@qti-pie/crust": "workspace:*",
    "effect": "catalog:",
    "pg": "catalog:",
    "saxes": "catalog:"
  },
  "devDependencies": {
    "@bjornpagen/devtools": "workspace:*",
    "@effect/vitest": "catalog:",
    "@qti-pie/plan-budget": "workspace:*",
    "@qti-pie/plate": "workspace:*",
    "@types/pg": "catalog:",
    "oxfmt": "catalog:",
    "vitest": "catalog:"
  }
}
