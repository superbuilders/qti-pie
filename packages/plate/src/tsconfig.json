{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "lib": ["esnext", "dom"],
    "types": ["node", "react/experimental"],
    "customConditions": ["browser", "production"],
    "jsx": "react-jsx",
    "tsBuildInfoFile": "../node_modules/.cache/tsconfig.src.tsbuildinfo"
  },
  "include": [
    "ui/**/*.ts",
    "ui/**/*.tsx",
    "rich-text/**/*.ts",
    "alpha/math-entry/**/*.ts",
    "alpha/math-entry/**/*.tsx",
    "alpha/pci-modules/**/*.ts",
    "alpha/renderers.ts",
    "alpha/choice/**/*.ts",
    "alpha/choice/**/*.tsx",
    "alpha/text-entry/**/*.tsx"
  ],
  "exclude": ["**/node_modules"]
}
