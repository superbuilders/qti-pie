{
  "name": "@qti-pie/plate",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#plate/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./admission-codes": "./src/admission-codes.ts",
    "./alpha": "./src/alpha/renderers.ts",
    "./alpha/math-entry": "./src/alpha/math-entry/field.ts",
    "./alpha/pci-modules": "./src/alpha/pci-modules.ts",
    "./alpha/styles/base.css": "./src/alpha/styles/base.css",
    "./alpha/styles/theme.css": "./src/alpha/styles/theme.css",
    "./codec": "./src/codec/values.ts",
    "./rich-text": "./src/rich-text/xhtml.ts",
    "./ui": "./src/ui/index.ts",
    "./ui/client": "./src/ui/client.ts",
    "./ui/props": "./src/ui/props.ts",
    "./ui/pci-frame": "./src/ui/portable-custom/frame-page.ts",
    "./styles/base.css": "./src/styles/base.css",
    "./styles/theme.css": "./src/styles/theme.css",
    "./test/admitted": "./src/test/admitted.ts",
    "./test/catalog-shown": "./src/test/catalog-shown.ts",
    "./test/corpus": "./src/test/corpus.ts",
    "./test/golden": "./src/test/golden.ts",
    "./test/records": "./src/test/records.ts",
    "./words": "./src/words.ts"
  },
  "scripts": {
    "emit:alpha-pci-modules": "node src/alpha/emit-pci-modules.ts",
    "typecheck": "sh -c 'toolchain-typecheck -p src/tsconfig.json \"$@\" & toolchain-typecheck -p tsconfig.json \"$@\"; plate=$?; wait $! && exit $plate' typecheck",
    "test": "mkdir -p work/.vp-tmp && TMPDIR=\"$PWD/work/.vp-tmp\" NODE_OPTIONS=\"$NODE_OPTIONS --disable-proto=delete --disable-sigusr1\" vitest run"
  },
  "dependencies": {
    "@qti-pie/crust": "workspace:*",
    "@ui-sdk/core": "catalog:",
    "@ui-sdk/react": "catalog:",
    "arkregex": "catalog:",
    "effect": "catalog:",
    "mathjax-full": "catalog:",
    "mathlive": "catalog:",
    "quill": "catalog:",
    "quill-delta": "catalog:"
  },
  "devDependencies": {
    "@bjornpagen/devtools": "workspace:*",
    "@effect/vitest": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxc-parser": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
