<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0p1_v1p0.xsd"
  identifier="ei-limits-select-point" title="Points to mark on the garden" adaptive="false"
  time-dependent="false" xml:lang="en">
  <qti-response-declaration identifier="ONE" cardinality="multiple" base-type="point">
    <qti-correct-response>
      <qti-value>120 80</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-response-declaration identifier="SOME" cardinality="multiple" base-type="point"/>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float">
    <qti-default-value>
      <qti-value>0</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-item-body>
    <qti-select-point-interaction response-identifier="ONE" min-choices="1" max-choices="1">
      <qti-prompt>Mark the pond.</qti-prompt>
      <img src="images/select-point-map.svg" width="400" height="300"
        alt="A plan of a walled garden with a round pond, a fenced bed and a path"/>
    </qti-select-point-interaction>
    <qti-select-point-interaction response-identifier="SOME" min-choices="2" max-choices="3">
      <qti-prompt>Mark two or three places to sit.</qti-prompt>
      <img src="images/select-point-map.svg" width="400" height="300"
        alt="A plan of a walled garden with a round pond, a fenced bed and a path"/>
    </qti-select-point-interaction>
  </qti-item-body>
</qti-assessment-item>
