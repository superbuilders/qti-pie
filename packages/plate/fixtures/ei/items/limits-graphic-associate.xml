<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0p1_v1p0.xsd"
  identifier="ei-limits-graphic-associate" title="Farm paths to draw" adaptive="false"
  time-dependent="false" xml:lang="en">
  <qti-response-declaration identifier="ONE" cardinality="multiple" base-type="pair"/>
  <qti-response-declaration identifier="MANY" cardinality="multiple" base-type="pair"/>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float">
    <qti-default-value>
      <qti-value>0</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-item-body>
    <qti-graphic-associate-interaction response-identifier="ONE" min-associations="1">
      <qti-prompt>Draw one path between two places.</qti-prompt>
      <img src="images/graphic-associate-map.svg" width="320" height="200"
        alt="A farm with a well, a barn and an oak in a field"/>
      <qti-associable-hotspot identifier="H1" shape="rect" coords="20,30,90,90" hotspot-label="Well" match-max="1"/>
      <qti-associable-hotspot identifier="H3" shape="circle" coords="170,70,30" hotspot-label="Barn" match-max="0"/>
      <qti-associable-hotspot identifier="H4" shape="poly" coords="220,170,260,110,300,170" hotspot-label="Oak" match-max="0"/>
    </qti-graphic-associate-interaction>
    <qti-graphic-associate-interaction response-identifier="MANY" max-associations="0" min-associations="2">
      <qti-prompt>Draw at least two paths; the well joins only the barn.</qti-prompt>
      <img src="images/graphic-associate-map.svg" width="320" height="200"
        alt="A farm with a well, a barn and an oak in a field"/>
      <qti-associable-hotspot identifier="K1" shape="rect" coords="20,30,90,90" hotspot-label="Well" match-max="0" match-min="1" match-group="K2"/>
      <qti-associable-hotspot identifier="K2" shape="circle" coords="170,70,30" hotspot-label="Barn" match-max="0" match-min="2"/>
      <qti-associable-hotspot identifier="K3" shape="poly" coords="220,170,260,110,300,170" hotspot-label="Oak" match-max="0"/>
    </qti-graphic-associate-interaction>
  </qti-item-body>
</qti-assessment-item>
